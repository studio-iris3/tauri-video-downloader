{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Studio Iris Video Downloader",
  "version": "1.0.0",
  "identifier": "com.studioiris.video-downloader",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Studio Iris Video Downloader",
        "width": 1100,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
